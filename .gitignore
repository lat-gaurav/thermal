# Raw captures: ~43 MB/s, ~155 GB/hour. Never commit these.
# No trailing slash: on this rig `recordings` is a SYMLINK to the external SSD,
# and `recordings/` does not match a symlink -- so it kept showing up as
# untracked, dangling, pointing at a mount that is not always there.
recordings

# Symlink to external SSD logs folder (/Volumes/PortableSSD/logs) — machine-specific
logs

# Compiled binary; rebuild with:
#   gcc -O2 -Wall -Wextra -o bin/record_raw tools/record_raw.c
bin/record_raw
sync_log
tlm_log
flow_post
flow_live
record_sync
logs
thermal_camera_data
# Python bytecode
__pycache__/

# Copies of whatever was in /etc before deploy/install.sh replaced it.
deploy/backups/
