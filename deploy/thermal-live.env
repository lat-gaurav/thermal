# Settings for the live thermal pipeline. Installed to /etc/default/thermal-live.
# Edit there, then:  sudo systemctl restart thermal-live
#
# deploy/run_live.sh reads every one of these; nothing is duplicated in the unit.

# --- what to read -----------------------------------------------------------
# The node is pinned by USB serial through a udev SYMLINK, never by kernel name:
# /dev/videoN numbers drift on re-enumeration (docs/DEVICE_NODES.md). Note that
# /dev/video1 is the UVC METADATA node -- it opens without error and then never
# yields a frame, so pointing this at it produces a viewer that starts cleanly
# and shows nothing.
THERMAL_DEVICE=/dev/thermal0

# The core advertises exactly one size, 1280x1024, in GREY / NV12 / YU12 / YUYV.
# GREY is what the viewer asks for and the cheapest of the four at 1 byte/px.
# Three quarters of those pixels are interpolated -- the sensor is 640x512.
THERMAL_WIDTH=1280
THERMAL_HEIGHT=1024

# 25, or 50, or empty to leave the core alone. The core forgets this on every
# power cycle, so run_live.sh re-applies it per start. 25 is the only rate the
# USB path honours end to end; mode 50 measures 30.17 fps, not 50.
THERMAL_SET_FPS=25

# --- where it comes out -----------------------------------------------------
# web  : HTTP viewer, reachable from any machine on the network, works headless.
#        Detector + clutter rejection only: a viewer has no attitude source, so
#        no LOS, no tracker, and no ROI crop -- ~1.3 fps.
# track: the FULL pipeline, headless -- live attitude from the Cube, LOS
#        prediction, ROI-cropped detection, tracker, and the bearing uplink.
#        MEASURED 11.1 fps, because the tracker's gate lets detection run on a
#        ~520x300 crop (86 ms) instead of the whole frame (712 ms). Needs the
#        Cube link: run deploy/setup_comms.sh first.
# flight: THE SORTIE MODE, and the operational equivalent of what this rig flew
#        before. Everything in `track`, plus the two RC switches (ch7 runs the
#        algorithm, ch6 records), .rawrec episodes per record switch-on, a
#        per-frame CSV, and one shared timestamp across the CSV and every
#        episode. Both switches fail safe: no RC for 2 s is OFF.
# fb   : draws straight into the KMS framebuffer on an attached HDMI screen.
#        NOTE /dev/fb0 does not exist on this host as it currently boots, so fb
#        mode will refuse to start until a display is attached and the console
#        comes up on KMS.
THERMAL_MODE=web

THERMAL_HOST=0.0.0.0
# 8001, not 8000: another service on this host already binds 8000, and two
# things fighting over a port is a confusing failure to debug in the field.
THERMAL_PORT=8001

# fb mode only. Empty means no detection, just the raw feed at full rate --
# which is the right default there, because fb mode redraws on a timer rather
# than on demand, so a ~0.7 s detector turns the screen into a slideshow.
# Set to a module name from detector/ (e.g. tophat_scr) to box its hits.
THERMAL_FB_DETECT=
THERMAL_FBDEV=/dev/fb0
THERMAL_MAX_FPS=30

# --- startup patience -------------------------------------------------------
# Applied twice: once waiting for the device node to appear (USB enumeration is
# slower than boot) and once waiting for whoever holds the camera to let go.
# TimeoutStartSec in the unit is 180 to cover both plus the fps set.
THERMAL_WAIT_SECS=60

# --- track mode: the Cube link ----------------------------------------------
# Ignored in web and fb mode. TELEM2 admits ONE reader, the same rule as the
# camera, so run_live.sh waits for the port and then refuses rather than opening
# a second reader that gets half the bytes.
THERMAL_CUBE_DEVICE=/dev/ttyAMA0
THERMAL_CUBE_BAUD=57600

# 1 = send DETECTION_TARGET_DATA to the Cube. 0 = run the whole pipeline but
# transmit nothing, which is the right setting for a first flight-line check:
# everything downstream of the detector is exercised without anything reaching
# guidance.
THERMAL_UPLINK=1

# Optional per-frame CSV (idx, t_mono, quaternion, tracker status, ROI, bearing).
# Empty = no log. ~120 B/row, so ~5 MB/hour at 11 fps -- unlike the raw video
# path this is not a card-space concern.
THERMAL_TRACK_CSV=

# --- flight mode -------------------------------------------------------------
# Where the sortie's files go. One timestamp, computed once per start, is shared
# by  los-<stamp>.csv  and  flight-<stamp>-NN.rawrec  so the pair is
# unambiguous. This points at the SSD symlink.
THERMAL_LOG_DIR=/home/rpi5/thermal/logs

# WHERE IT GOES IF THE SSD IS NOT THERE. logs/ is a symlink to
# /mnt/external_ssd/logs; unmounted, that symlink dangles and
# /mnt/external_ssd is an ordinary empty directory ON THE SD CARD. Writing
# there would push ~118 GB/hour into the root filesystem through a path that
# still looks like the SSD, and a full root filesystem takes the journal, the
# CSV and probably the pipeline with it. So run_live.sh checks that
# THERMAL_LOG_DIR really is on a filesystem other than root, and uses this
# instead when it is not. On the SD card that is MINUTES of recording, not
# hours -- the startup log prints the actual budget.
THERMAL_LOG_DIR_FALLBACK=/home/rpi5/flight-logs

# 1 = require THERMAL_LOG_DIR to be on external storage, else fall back as above.
# 0 = trust THERMAL_LOG_DIR wherever it is (set this if you deliberately want to
#     record onto the SD card at the primary path).
THERMAL_REQUIRE_EXTERNAL=1

# 1 = write .rawrec episodes when the record switch (ch6) is ON.
# 0 = CSV only. The CSV is ~5 MB/hour; raw is ~118 GB/hour.
THERMAL_RECORD=1

# Stop recording before the card has less than this free, so a full disk cannot
# take the CSV log or the pipeline down with it. The pipeline keeps flying and
# says so.
THERMAL_RAW_RESERVE_MB=2048

# A bigger reserve applies on the fallback, because that is the ROOT filesystem:
# running it dry does not merely lose the recording, it can take the system down.
THERMAL_RAW_RESERVE_MB_FALLBACK=8192

# 1 = ignore the RC switches entirely: algorithm on from startup, and record
# immediately if THERMAL_RECORD=1. For bench work with no transmitter. In the
# air this should be 0, so the crew keeps the switch authority they expect.
THERMAL_ALWAYS_ON=0

# Pin the detector instead of taking whichever sorts first in detector/. Leave
# empty for the default. Worth setting explicitly for a sortie: adding a file to
# detector/ can otherwise change which detector flies.
THERMAL_DETECTOR=
